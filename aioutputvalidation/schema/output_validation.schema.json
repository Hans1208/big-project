{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI Output Validation Audit Record",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "model_name", "model_version", "policy_version", "decision", "validation", "review_reasons", "privacy_note"],
  "properties": {
    "contract_version": {"const": "1.0"},
    "model_name": {"type": "string", "minLength": 1},
    "model_version": {"type": "string", "minLength": 1},
    "policy_version": {"type": "string", "minLength": 1},
    "decision": {"enum": ["safe", "review_required", "high_risk"]},
    "validation": {
      "type": "object", "additionalProperties": false,
      "required": ["valid", "schema_errors", "evidence_score", "claim_evidence_scores", "hallucination_probability", "decision"],
      "properties": {
        "valid": {"type": "boolean"},
        "schema_errors": {"type": "array", "items": {"type": "string"}},
        "evidence_score": {"type": "number", "minimum": 0, "maximum": 1},
        "claim_evidence_scores": {"type": "array", "items": {"type": "number", "minimum": -1, "maximum": 1}},
        "hallucination_probability": {"type": "number", "minimum": 0, "maximum": 1},
        "decision": {"enum": ["safe", "review_required", "high_risk"]}
      }
    },
    "review_reasons": {"type": "array", "items": {"type": "string"}},
    "privacy_note": {"type": "string", "minLength": 1},
    "record_id": {"type": "string"}
  }
}
